{
  "version": "0.2.1",
  "license": "MIT",
  "keywords": [
    "countries",
    "country codes",
    "ISO 3166",
    "iso-3166",
    "ISO 3166-1",
    "iso-3166-1",
    "ISO 3166-1 Alpha-2",
    "iso-3166-1-alpha-2",
    "ISO 3166-1 Alpha-3",
    "iso-3166-1-alpha-3",
    "ISO 3166-1 Numeric",
    "iso-3166-1-numeric"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takuma7/iso-3166-1-ts.git",
    "directory": "packages/iso-3166-1-ts"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "docs": "typedoc --plugin typedoc-plugin-markdown --gitRevision main --out ../../docs/api src/index.ts",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {},
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "iso-3166-1-ts",
  "author": "takuma7",
  "module": "dist/index.mjs",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "10 KB"
    }
  ]
}
