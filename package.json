{
  "name": "iso-3166-1-workspace",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --filter iso-3166-1-ts start",
    "lint": "oxlint --deny-warnings packages scripts",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:package": "pnpm -r test:package",
    "prepare": "pnpm build && husky",
    "size": "pnpm --filter iso-3166-1-ts size",
    "analyze": "pnpm --filter iso-3166-1-ts analyze",
    "docs": "pnpm --filter iso-3166-1-ts run docs",
    "generate-code": "tsx scripts/generate-code/index.ts",
    "data:check": "tsx scripts/generate-code/index.ts --check",
    "data:update": "tsx scripts/update-data.ts",
    "test:browser": "pnpm --filter get-country-codes test:browser"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "csv-parse": "^7.0.3",
    "husky": "^9.1.7",
    "oxlint": "^1.88.0",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "@types/yargs": "^17.0.33",
    "csv-stringify": "^6.6.0"
  },
  "type": "module"
}
