{
  "version": "0.2.1",
  "license": "MIT",
  "keywords": [
    "countries",
    "country codes",
    "ISO 3166",
    "iso-3166",
    "ISO 3166-1",
    "iso-3166-1",
    "ISO 3166-1 Alpha-2",
    "iso-3166-1-alpha-2",
    "ISO 3166-1 Alpha-3",
    "iso-3166-1-alpha-3",
    "ISO 3166-1 Numeric",
    "iso-3166-1-numeric"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takuma7/iso-3166-1-ts.git"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src scripts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "prepare": "pnpm build && husky",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "generate-code": "tsx ./scripts/generate-code/index.ts",
    "docs": "typedoc --plugin typedoc-plugin-markdown --out docs src/index.ts"
  },
  "peerDependencies": {},
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "iso-3166-1-ts",
  "author": "takuma7",
  "module": "dist/index.mjs",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "csv-parse": "^7.0.3",
    "husky": "^9.1.7",
    "oxlint": "^1.88.0",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
